
@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
<table>
    <thead>
        <th>Nombre</th>
        <th>Estado</th>
        <th>Precio</th>
    </thead>
    <tbody>
        @foreach (LogicaNegocio.Publicacion publicacion in ViewBag.ListaPublicaciones)
        {
            <tr>
                <td>@publicacion.Nombre</td>
                <td>@publicacion.Estado</td>
                <td>@publicacion.</td>
            </tr>
        }
    </tbody>
</table>

